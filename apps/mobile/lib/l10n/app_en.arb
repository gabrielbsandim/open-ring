  "@energyOursBase": {"placeholders": {"factor": {"type": "String"}}},
  "energyLimitsBase": "It is spread evenly, so it grows at the same speed asleep and awake. In real life the night is slower and the day faster.",
  "energyWhatSteps": "The energy of walking around, outside recorded workouts. Steps taken during a workout count there, never twice.",
  "energyRuleSteps": "Each step is {length} × your height, which gives a distance. Each kilometre then costs {cost} kcal per kilo of body weight.",
  "@energyRuleSteps": {"placeholders": {"length": {"type": "String"}, "cost": {"type": "String"}}},
  "energySourceSteps": "The net cost of level walking in exercise physiology texts is close to this figure.",
